# Copy to .env and fill in. NEVER commit the real .env.
#
# Bot tokens issued by BotFather (https://t.me/BotFather). Full-access credentials —
# treat them like passwords. Read only from the environment at runtime.
# Production bot — used by default.
BOT_TOKEN=
# Test bot — used when BOT_ENV=test (see below). Needed only for development.
TEST_BOT_TOKEN=

# Optional. Selects which bot to run. Set to "test" (or "dev") to use TEST_BOT_TOKEN
# and a separate database; anything else (including unset) runs the production bot.
# Example dev run:  BOT_ENV=test ./run.sh
# BOT_ENV=test

# Optional. IANA timezone assigned to new users on first /start (changeable per user
# with /timezone). If unset, the bot uses the host machine's timezone, then UTC.
# DEFAULT_TZ=Europe/Kyiv

# Required. PostgreSQL connection string for the production database, e.g.
# postgresql://user:password@host:5432/reminders
DATABASE_URL=
TEST_DATABASE_URL=

# Required for development/tests. Separate connection string used when BOT_ENV=test
# (see above) and by the test suite, so dev/test runs never touch the production
# database. Point it at a scratch database — the test suite truncates its tables.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/reminders_test

# Required. Your own Telegram chat_id — /support forwards user messages here. Same
# value for both the production and test bot; get it by messaging your bot once and
# checking the users table, or via a bot like @userinfobot.
ADMIN_CHAT_ID=
